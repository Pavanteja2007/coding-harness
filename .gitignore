# --- Project-specific ---
# Structured logs + full traces (INTERFACES.md layout) — never commit these.
logs/
# Terminal 15: sanitized release evidence bundles are the committed,
# reviewable counterpart to the gitignored logs above. Only bundles that
# pass `python -m evals.evidence verify` belong here; build them with
# `python -m evals.evidence build --out evidence/bundles`.
!evidence/
evidence/bundles/*
!evidence/bundles/
!evidence/bundles/*/
evidence/bundles/*/purge_receipts.jsonl
evidence/bundles/**/traces/
# Offline demo workspace (regenerated per run; see demo/README.md)
demo/demo-work/
demo/demo-work-agent/
# Harness runtime state (memory layer: decisions.db, code-graph)
.harness/
# Generated knowledge-graph output (graphify skill)
graphify-out/
# Local AI-tooling config (opencode session plugin; not project code)
.opencode/


