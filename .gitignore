# committed either.
.vex/settings.local.toml
.vex/connectors.local.toml
memory/.vex/connectors-state.json
logs/terminal-ux/terminal-04-r2/

# --- Build-plan prompts and scratch ---
# The phase prompts (P0..P7) are the build PLAN, not the product. They are
# working material for the build, not something a user of the package needs.
# Nothing in cli/, harness/, tests/ or the workflows reads them.
phases/
# Every build/master prompt at the repo root, in both spellings:
# `MASTER_BUILD_PROMPT.md`, `MASTER_BUILD_PROMPT-v1-backup.md`, and the
# `VEX_*_MASTER_PROMPTS.md` archives. The middle `*` matters: the first two
# contain "MASTER_BUILD_PROMPT", not "MASTER_PROMPT", so a
# `*MASTER_PROMPT*.md` pattern silently misses them.
*MASTER*PROMPT*.md

# Superseded design drafts. The live contract is NEO_DESIGN_SYSTEM.md (below);
# these are the v1/v2 drafts it replaced. Mentioned in prose, never read.
DESIGN.md
DESIGN-v1-backup.md
DESIGN-v2-forge-backup.md
# The live design contract too: only ever referenced from two docstrings.
NEO_DESIGN_SYSTEM.md

# Per-terminal scratch: debug drivers, live-provider probes, screenshot
# scratch, resize/tab debug dirs. ~232 files, regenerated on demand.
Temp/
probe/
provenance/
repo/
.qwen/

# Ad-hoc probe output and the superseded static-site backup. Both were
# committed by accident at some point; the files stay on disk, they are just
# no longer tracked.
probe_logs/
site-v1-backup/

# Machine-local caches that got committed because a tool wrote them with a
# relative path from the wrong working directory. `pip/` is pip's own HTTP
# cache; `Microsoft/` is PowerShell's module analysis cache.
pip/
Microsoft/

# The PREVIOUS project-state directory, in full. The project config name is
# now `.neo/`; a checkout that still has a `.vex/` is mid-upgrade and its
# scaffold is leftover state, not project config to share.
.vex/
memory/.vex/

